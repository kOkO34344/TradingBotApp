# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Obsidian / Claudian app internals (the notes themselves ARE tracked)
**/.obsidian/
**/.claudian/

# Cached market data (regenerated on demand by the app)
price_data/
price_data_backtest/
price_data_live/
KronosAI/price_data_hourly/
KronosAI/price_data_hourly_live/
KronosAI/price_data_assetclass/

# Credentials. secrets/ holds one file per provider (see secrets_store.py).
# Its CONTENTS are ignored, but the README and the .example templates ARE
# tracked so a fresh clone can see what needs filling in without ever holding
# a value. Note the rule is `secrets/*` and NOT `secrets*`: an ignored
# DIRECTORY is never descended into, so the negations below would silently do
# nothing and the templates would vanish from the repo.
*.env
secrets/*
!secrets/README.md
!secrets/*.example
# ...and a stray secrets.json / secrets.yaml dropped anywhere else.
secrets.*

# Runtime logs from the daily vault-sync automation (grows continuously,
# not meaningful version-controlled content)
vault_sync.log
vault_sync_launchd.log

# Daily digest automation: same deal — runtime log, not content
daily_digest.log
daily_digest_launchd.log

# Generic run-notify wrapper logs and per-run backtest logs
run_logs/
KronosAI/backtest_logs/

# Trade-reflection automation: logs grow continuously (not meaningful
# version-controlled content); dedup state is machine state, not content —
# the trade_reflections/*.md reflections themselves ARE tracked
trade_reflect.log
trade_reflect_launchd.log
trade_reflections/.reflected_execids.json
trade_reflections/.position_snapshot.json

# TelegramBot: runtime log of send failures (for debugging delivery, not
# meaningful version-controlled content)
TelegramBot/failed_sends.log
daily_digest.log
daily_digest_launchd.log

# Kronos backtest checkpoint: raw intermediate walk-forward results, saved
# so a crash in reporting doesn't cost re-running the (slow) forecasting
# loop. Machine state for --from-checkpoint, not meaningful version-controlled
# content — the actual findings are written into CLAUDE.md and the vault.
KronosAI/kronos_backtest_checkpoint.json

# Autotrade automation: runtime logs, not content
autotrade_runner.log
autotrade_launchd.log

# Claude Code session state. The skills under .claude/skills/ ARE tracked
# (they carry project guidance); these two are not:
#   settings.local.json — this machine's permission allowlist, not content
#   worktrees/          — live git worktrees, already tracked via their own refs
.claude/settings.local.json
.claude/worktrees/

# FTMO rule-decision audit trail: runtime forensic data, one JSONL file per
# FTMO day. Not version-controlled content — the findings that matter get
# written into CLAUDE.md, same convention as autotrade_runner.log.
ftmo_audit/

# Timestamped safety copies written by trade_journal.migrate() before it
# rewrites the journal in place. The point of them is local recovery if a
# migration ever goes wrong; committing them would put several near-identical
# copies of the audit trail in the history and make it ambiguous which one is
# the journal.
trade_journal.csv.bak-*

# The FTMO runner's day-boundary memory (day-start balance, trailing high-water
# mark, trading-day count). Runtime state that belongs to THIS machine's
# account — committing it would mean a checkout on another machine inheriting
# a day-start balance from an account it is not connected to, which is exactly
# how the daily limit would evaluate against a fiction.
ftmo_runner_state.json
ftmo_runner.log
