# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Obsidian / Claudian app internals (the notes themselves ARE tracked)
**/.obsidian/
**/.claudian/

# Cached market data (regenerated on demand by the app)
price_data/
price_data_backtest/
price_data_live/

# IBKR credentials or local secrets, if ever added
*.env
secrets*

# Runtime logs from the daily vault-sync automation (grows continuously,
# not meaningful version-controlled content)
vault_sync.log
vault_sync_launchd.log

# Trade-reflection automation: logs grow continuously (not meaningful
# version-controlled content); dedup state is machine state, not content —
# the trade_reflections/*.md reflections themselves ARE tracked
trade_reflect.log
trade_reflect_launchd.log
trade_reflections/.reflected_execids.json
