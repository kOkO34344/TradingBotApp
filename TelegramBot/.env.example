# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is already gitignored (see .gitignore's `*.env` rule) — never commit
# the real one. Setup steps for getting these two values are in notify.py's
# module docstring (message @BotFather on Telegram, then notify.py --get-chat-id).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
